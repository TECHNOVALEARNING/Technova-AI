# ─── Supabase (votre propre projet : Project Settings → API) ───────────────
# Côté navigateur (publics) :
VITE_SUPABASE_URL="https://xxxxxxxx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Côté serveur :
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."          # SECRET — jamais dans le navigateur
# Uniquement pour `npm run db:migrate` (Connect → Session pooler) :
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# ─── Application ─────────────────────────────────────────────────────────
TECHNOVA_APP_URL="https://votre-domaine.vercel.app"  # URL publique, sans / final
TECHNOVA_CONN_CRYPTO_KEY=""                         # SECRET — `openssl rand -hex 32` ; ne plus jamais la changer
CRON_SECRET=""                                      # SECRET — `openssl rand -hex 32` (Vercel Cron)

# ─── IA ──────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY="sk-or-..."                      # Chat, API publique et TechNova Studio
# Admin console balance only: an OpenRouter management key (cannot generate replies). OPENROUTER_API_KEY must be a regular API key.
OPENROUTER_MANAGEMENT_KEY=
STUDIO_MODEL="anthropic/claude-sonnet-5"            # optionnel
KIE_API_KEY=""                                      # Génération d'images/vidéos (kie.ai)
DEEPSEEK_API_KEY=""                                 # Assistant d'aide des pages publiques (DeepSeek, platform.deepseek.com) ;
                                                    # vide = DeepSeek via OpenRouter sans conservation des questions

# ─── Paiements (Nyole / AfriFlow) ────────────────────────────────────────
NYOLE_SECRET_KEY=""
NYOLE_WEBHOOK_SECRET=""                             # facultatif : secret de signature du webhook
NYOLE_ALLOW_TEST_PAYMENTS=""                        # "true" seulement pendant un test en production (vaut aussi pour FeexPay)

# ─── Paiements (FeexPay : cartes + Mobile Money des pays couverts ; voir docs/paiements-feexpay.md)
FEEXPAY_API_KEY=""                                  # test_key_… (sandbox) ou fp_… (production)
FEEXPAY_SHOP_ID=""                                  # identifiant de la boutique FeexPay
FEEXPAY_WEBHOOK_SECRET=""                           # même valeur que le « Bearer » du webhook dans FeexPay

# ─── Connecteurs (OAuth apps à vous ; redirect URI = $TECHNOVA_APP_URL/oauth/connect/return)
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
GOOGLE_DRIVE_OAUTH_CLIENT_ID=""
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=""
NOTION_OAUTH_CLIENT_ID=""
NOTION_OAUTH_CLIENT_SECRET=""

# ─── Connexion « Supabase de l'utilisateur » (OAuth app Supabase ; redirect = $TECHNOVA_APP_URL/api/public/supabase-oauth/callback)
TECHNOVA_OAUTH_CLIENT_ID=""
TECHNOVA_OAUTH_CLIENT_SECRET=""
TECHNOVA_OAUTH_SCOPE=""

# ─── Sites publiés (facultatif) : domaine générique *.SITES_BASE_DOMAIN pointant vers Vercel
SITES_BASE_DOMAIN=""
